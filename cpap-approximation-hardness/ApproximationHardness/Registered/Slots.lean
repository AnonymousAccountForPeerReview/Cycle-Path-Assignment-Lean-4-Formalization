module

public import ApproximationHardness.Registered.Registers
import Lean.Elab.Tactic.Omega

/-!
# Disequalities between slot registers and the other registers

Generated by `scripts/generate_slots.py`; these are `simp` lemmas so that
`simp +decide [StackMachine.set]` evaluates every register read of a `set` chain.
-/

@[expose] public section

namespace STACS2027.Registered

theorem slotV_cases (i : Nat) : slotV i = R.v0 ∨ slotV i = R.v1 ∨ slotV i = R.v2 := by
  match i with
  | 0 => exact Or.inl rfl
  | 1 => exact Or.inr (Or.inl rfl)
  | _ + 2 => exact Or.inr (Or.inr rfl)

theorem slotS_cases (i : Nat) : slotS i = R.sg0 ∨ slotS i = R.sg1 ∨ slotS i = R.sg2 := by
  match i with
  | 0 => exact Or.inl rfl
  | 1 => exact Or.inr (Or.inl rfl)
  | _ + 2 => exact Or.inr (Or.inr rfl)

theorem slotB_cases (i : Nat) : slotB i = R.b0 ∨ slotB i = R.b1 ∨ slotB i = R.b2 := by
  match i with
  | 0 => exact Or.inl rfl
  | 1 => exact Or.inr (Or.inl rfl)
  | _ + 2 => exact Or.inr (Or.inr rfl)

theorem slotE_cases (i : Nat) (side : Bool) : slotE i side = R.ef0 ∨ slotE i side = R.et0 ∨
    slotE i side = R.ef1 ∨ slotE i side = R.et1 ∨ slotE i side = R.ef2 ∨ slotE i side = R.et2 := by
  match i, side with
  | 0, false => exact Or.inl rfl
  | 0, true => exact Or.inr (Or.inl rfl)
  | 1, false => exact Or.inr (Or.inr (Or.inl rfl))
  | 1, true => exact Or.inr (Or.inr (Or.inr (Or.inl rfl)))
  | _ + 2, false => exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl))))
  | _ + 2, true => exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr rfl))))

theorem slotV_ne (i : Nat) (j : Reg) (hj : j ≠ R.v0 ∧ j ≠ R.v1 ∧ j ≠ R.v2) : slotV i ≠ j := by
  rcases slotV_cases i with h | h | h <;> rw [h] <;> exact Ne.symm (by simp_all)

theorem slotS_ne (i : Nat) (j : Reg) (hj : j ≠ R.sg0 ∧ j ≠ R.sg1 ∧ j ≠ R.sg2) : slotS i ≠ j := by
  rcases slotS_cases i with h | h | h <;> rw [h] <;> exact Ne.symm (by simp_all)

theorem slotB_ne (i : Nat) (j : Reg) (hj : j ≠ R.b0 ∧ j ≠ R.b1 ∧ j ≠ R.b2) : slotB i ≠ j := by
  rcases slotB_cases i with h | h | h <;> rw [h] <;> exact Ne.symm (by simp_all)

theorem slotE_ne (i : Nat) (side : Bool) (j : Reg)
    (hj : j ≠ R.ef0 ∧ j ≠ R.et0 ∧ j ≠ R.ef1 ∧ j ≠ R.et1 ∧ j ≠ R.ef2 ∧ j ≠ R.et2) :
    slotE i side ≠ j := by
  rcases slotE_cases i side with h | h | h | h | h | h <;> rw [h] <;> exact Ne.symm (by simp_all)


