theorem slotE_false_cases (i : Nat) : slotE i false = R.ef0 ∨ slotE i false = R.ef1 ∨ slotE i false = R.ef2 := by
  match i with
  | 0 => exact Or.inl rfl
  | 1 => exact Or.inr (Or.inl rfl)
  | _ + 2 => exact Or.inr (Or.inr rfl)

theorem slotE_true_cases (i : Nat) : slotE i true = R.et0 ∨ slotE i true = R.et1 ∨ slotE i true = R.et2 := by
  match i with
  | 0 => exact Or.inl rfl
  | 1 => exact Or.inr (Or.inl rfl)
  | _ + 2 => exact Or.inr (Or.inr rfl)

@[simp] theorem slotE_ne_slotE_side (i i' : Nat) : slotE i false ≠ slotE i' true := by
  rcases slotE_false_cases i with h | h | h <;> rcases slotE_true_cases i' with h' | h' | h' <;>
    rw [h, h'] <;> decide
@[simp] theorem slotE_ne_slotE_side' (i i' : Nat) : slotE i true ≠ slotE i' false := (slotE_ne_slotE_side i' i).symm

/-- Slot registers of different slots are different. -/
theorem slotV_injective {i i' : Nat} (hi : i < 3) (hi' : i' < 3) (h : slotV i = slotV i') : i = i' := by
  match i, i' with
  | 0, 0 | 1, 1 | 2, 2 => rfl
  | 0, 1 | 0, 2 | 1, 0 | 1, 2 | 2, 0 | 2, 1 => exact absurd h (by decide)

theorem slotS_injective {i i' : Nat} (hi : i < 3) (hi' : i' < 3) (h : slotS i = slotS i') : i = i' := by
  match i, i' with
  | 0, 0 | 1, 1 | 2, 2 => rfl
  | 0, 1 | 0, 2 | 1, 0 | 1, 2 | 2, 0 | 2, 1 => exact absurd h (by decide)

theorem slotB_injective {i i' : Nat} (hi : i < 3) (hi' : i' < 3) (h : slotB i = slotB i') : i = i' := by
  match i, i' with
  | 0, 0 | 1, 1 | 2, 2 => rfl
  | 0, 1 | 0, 2 | 1, 0 | 1, 2 | 2, 0 | 2, 1 => exact absurd h (by decide)

theorem slotE_injective {i i' : Nat} {b b' : Bool} (hi : i < 3) (hi' : i' < 3)
    (h : slotE i b = slotE i' b') : i = i' ∧ b = b' := by
  cases b <;> cases b' <;> match i, i' with
  | 0, 0 | 1, 1 | 2, 2 => first | exact ⟨rfl, rfl⟩ | exact absurd h (by decide)
  | 0, 1 | 0, 2 | 1, 0 | 1, 2 | 2, 0 | 2, 1 => exact absurd h (by decide)

